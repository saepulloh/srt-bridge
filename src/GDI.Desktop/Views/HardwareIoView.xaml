<UserControl x:Class="GDI.Desktop.Views.HardwareIoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GDI.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,20">

            <!-- PAGE HEADER -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="PROFESSIONAL HARDWARE I/O MANAGER" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="PCIe video capture boards, physical SDI/HDMI routing, and vendor SDK verification." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassBtnSecondary}" Content="Rescan Hardware" Command="{Binding RescanCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GlassBtnPrimary}" Content="Validate &amp; Save Routing" Command="{Binding SaveRoutingCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- HARDWARE STATUS BANNER -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STATUS:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding HardwareSummary}" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="DeckLink Duo 2 · 4 independent 3G-SDI subdevices active" FontSize="10" Foreground="{StaticResource LiveGreenBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- SECTION: PHYSICAL PORT ASSIGNMENT MATRIX -->
            <TextBlock Text="PHYSICAL PORT ASSIGNMENT MATRIX" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="0">
                <DataGrid ItemsSource="{Binding RoutingRows}" AutoGenerateColumns="False" Background="Transparent" Foreground="White" RowBackground="#0D141F" AlternatingRowBackground="#111B28" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2E42" BorderThickness="0" HeadersVisibility="Column" IsReadOnly="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#090E17"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#1F2E42"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOGICAL BUS / SOURCE" Binding="{Binding BusName}" Width="190">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ASSIGNED HARDWARE DEVICE" Binding="{Binding DeviceName}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="PHYSICAL CONNECTOR / PORT" Binding="{Binding PortName}" Width="190">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="PORT DIRECTION" Binding="{Binding Direction}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="HARDWARE TEST STATUS" Binding="{Binding Status}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource LiveGreenBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- SECTION: VENDOR SDK HARDWARE CARDS -->
            <TextBlock Text="VENDOR HARDWARE INVENTORY &amp; SDK REPORT" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Blackmagic Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="BLACKMAGIC DESIGN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentBlueBrush}"/>
                            <Border Background="{StaticResource LiveGreenBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                <TextBlock Text="CONNECTED" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="DeckLink Duo 2 (PCIe x4)" FontWeight="Bold" FontSize="13" Foreground="White"/>
                        <TextBlock Text="Driver: Desktop Video 14.x" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                        <TextBlock Text="Capabilities: 4x SDI In/Out, 1080p60, 16-channel audio, hardware bypass relays." FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- AJA Card -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="6,0,6,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="AJA VIDEO SYSTEMS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Background="#26384F" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                <TextBlock Text="NOT INSTALLED" FontSize="9" FontWeight="Bold" Foreground="LightGray"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="KONA / Corvid Series" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Driver: NTV2 SDK" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6"/>
                        <TextBlock Text="Status: SDK initialized. No physical AJA PCIe board detected." FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Magewell Card -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="MAGEWELL" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Background="#26384F" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                <TextBlock Text="NOT INSTALLED" FontSize="9" FontWeight="Bold" Foreground="LightGray"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Pro Capture Family" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Driver: MWCapture SDK" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6"/>
                        <TextBlock Text="Status: SDK initialized. No physical Magewell board detected." FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SECTION: EXTERNAL OUTPUT CONTROL PANEL (vMix / OBS Architecture) -->
            <TextBlock Text="EXTERNAL OUTPUT CONTROL PANEL (DECKLINK SCHEDULED PLAYOUT)" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,20,0,10"/>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <!-- Settings Grid: Device, Port, Mode, Pixel Format -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hardware Device -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="OUTPUT DEVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" Style="{StaticResource GlassComboBox}"/>
                        </StackPanel>

                        <!-- Physical Port -->
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="SDI CONNECTOR PORT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" Style="{StaticResource GlassComboBox}"/>
                        </StackPanel>

                        <!-- Video Mode -->
                        <StackPanel Grid.Column="2" Margin="8,0,8,0">
                            <TextBlock Text="BROADCAST VIDEO MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}" Style="{StaticResource GlassComboBox}"/>
                        </StackPanel>

                        <!-- Pixel Format -->
                        <StackPanel Grid.Column="3" Margin="8,0,0,0">
                            <TextBlock Text="COLOR / PIXEL PRECISION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailablePixelFormats}" SelectedItem="{Binding SelectedPixelFormat}" Style="{StaticResource GlassComboBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Routing Source, Buffer, and Audio Settings -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Playout Source -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="OUTPUT SOURCE BUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSource}" Style="{StaticResource GlassComboBox}"/>
                        </StackPanel>

                        <!-- Audio Mapping -->
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="SDI EMBEDDED AUDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableAudioChannels}" SelectedItem="{Binding SelectedAudioChannels}" Style="{StaticResource GlassComboBox}"/>
                        </StackPanel>

                        <!-- Pre-roll Queue Buffer -->
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="PRE-ROLL BUFFER (FRAMES)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PrerollBufferFrames}" Style="{StaticResource GlassTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Playout Action Bar & Live Telemetry -->
                    <Border Background="#090E17" CornerRadius="6" Padding="12" BorderBrush="#162232" BorderThickness="1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassBtnPrimary}" Content="▶ Start External Output" Command="{Binding StartExternalOutputCommand}" IsEnabled="{Binding CanStartExternalOutput}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GlassBtnSecondary}" Content="■ Stop Output" Command="{Binding StopExternalOutputCommand}" IsEnabled="{Binding IsExternalOutputRunning}" Margin="0,0,16,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExternalOutputStatus}" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="vMix-style scheduled hardware playback · Zero frame jitter" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="FRAMES PLAYED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding FramesPlayed}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource LiveGreenBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="DROPPED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding DroppedFrames}" FontSize="12" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="HARDWARE FPS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding HardwareOutputFps, StringFormat='{}{0:F1} fps'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SECTION: HARDWARE DIAGNOSTIC TEST SUITE (TESTS A / B / C / D) -->
            <DockPanel Margin="0,10,0,10">
                <TextBlock Text="DIAGNOSTIC TEST SUITE &amp; CALIBRATION AUDIT" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="Clear Console" Command="{Binding ClearDiagnosticsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Test A Button -->
                <Button Grid.Column="0" Style="{StaticResource GlassBtnSecondary}" Margin="0,0,6,0" Padding="10,12" HorizontalContentAlignment="Left" Command="{Binding RunTestACommand}">
                    <StackPanel>
                        <TextBlock Text="TEST A: Direct Raw Pattern" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        <TextBlock Text="Bypasses codecs · Raw UYVY to SDI" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Test B Button -->
                <Button Grid.Column="1" Style="{StaticResource GlassBtnSecondary}" Margin="6,0,6,0" Padding="10,12" HorizontalContentAlignment="Left" Command="{Binding RunTestBCommand}">
                    <StackPanel>
                        <TextBlock Text="TEST B: SRT Loopback" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        <TextBlock Text="Local SRT transport &amp; codec audit" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Test C Button -->
                <Button Grid.Column="2" Style="{StaticResource GlassBtnSecondary}" Margin="6,0,6,0" Padding="10,12" HorizontalContentAlignment="Left" Command="{Binding RunTestCCommand}">
                    <StackPanel>
                        <TextBlock Text="TEST C: Local Uncompressed" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        <TextBlock Text="Evaluates buffer &amp; PCIe DMA link" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Test D Button -->
                <Button Grid.Column="3" Style="{StaticResource GlassBtnSecondary}" Margin="6,0,0,0" Padding="10,12" HorizontalContentAlignment="Left" Command="{Binding RunTestDCommand}">
                    <StackPanel>
                        <TextBlock Text="TEST D: vMix / OBS Benchmark" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        <TextBlock Text="Architecture reference verification" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Diagnostic Console Output -->
            <Border Background="#060A10" BorderBrush="#162232" BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="140">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="220">
                    <TextBox Text="{Binding DiagnosticResults}" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
