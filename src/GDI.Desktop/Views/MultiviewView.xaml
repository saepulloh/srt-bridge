<UserControl x:Class="GDI.Desktop.Views.MultiviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GDI.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="0,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP CONTROLS -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="BROADCAST MULTIVIEW" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="Layout:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" FontSize="11" FontWeight="Bold"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="1 View" Command="{Binding SetLayoutCommand}" CommandParameter="Single" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="2 View" Command="{Binding SetLayoutCommand}" CommandParameter="Dual" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="4 Quad" Command="{Binding SetLayoutCommand}" CommandParameter="Quad" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="6 View" Command="{Binding SetLayoutCommand}" CommandParameter="Hexa" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="8 View" Command="{Binding SetLayoutCommand}" CommandParameter="Octo" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="9 View" Command="{Binding SetLayoutCommand}" CommandParameter="Nine" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="16 View" Command="{Binding SetLayoutCommand}" CommandParameter="Sixteen" Margin="0,0,4,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="Custom" Command="{Binding SetLayoutCommand}" CommandParameter="Custom" Margin="0,0,12,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Style="{StaticResource GlassBtnPrimary}" Content="⚙ Custom Multiview" Command="{Binding OpenCustomConfigCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource GlassBtnSecondary}" Content="⛶ Fullscreen (F11)" Command="{Binding ToggleFullscreenCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- MULTIVIEW TILES CONTAINER -->
        <Border Grid.Row="1" Background="#04070B" CornerRadius="8" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="8">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" BorderThickness="2" Margin="5" Padding="10" Background="#080E17">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#1E2A3A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource ProgramRedBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#EF4444" BlurRadius="12" Direction="0" ShadowDepth="0" Opacity="0.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Tile Header: Tile Badge, Feed Dropdown & Live Badge -->
                                <DockPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Border Background="#162232" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TileNumber, StringFormat='{}T{0}'}" FontWeight="Bold" FontSize="10" Foreground="#38BDF8"/>
                                        </Border>
                                        <ComboBox ItemsSource="{Binding AvailableChannels}" 
                                                  SelectedItem="{Binding SelectedChannel}" 
                                                  DisplayMemberPath="DisplayName" 
                                                  Width="145" Height="22" FontSize="11" 
                                                  Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource LiveGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF-AIR"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                            <Setter Property="Text" Value="● LIVE"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DockPanel>

                                <!-- Tile Center Video Area & Vertical Portrait Audio Meter (Flanking Right) -->
                                <Grid Grid.Row="1" Margin="0,6,0,6" MinHeight="130">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Video Display (Live Video or SMPTE 75% Color Bars) -->
                                    <Border Grid.Column="0" Background="#04070B" CornerRadius="4" ClipToBounds="True">
                                        <Grid>
                                            <!-- SMPTE 75% Broadcast Color Bars (shown when off-air or no live frame) -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="67*"/>
                                                    <RowDefinition Height="8*"/>
                                                    <RowDefinition Height="25*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top 67%: 7 EIA Color Bars -->
                                                <UniformGrid Grid.Row="0" Rows="1" Columns="7">
                                                    <Rectangle Fill="#C0C0C0"/> <!-- 75% White -->
                                                    <Rectangle Fill="#C0C000"/> <!-- Yellow -->
                                                    <Rectangle Fill="#00C0C0"/> <!-- Cyan -->
                                                    <Rectangle Fill="#00C000"/> <!-- Green -->
                                                    <Rectangle Fill="#C000C0"/> <!-- Magenta -->
                                                    <Rectangle Fill="#C00000"/> <!-- Red -->
                                                    <Rectangle Fill="#0000C0"/> <!-- Blue -->
                                                </UniformGrid>

                                                <!-- Middle 8%: Cast sub-bars -->
                                                <UniformGrid Grid.Row="1" Rows="1" Columns="7">
                                                    <Rectangle Fill="#0000C0"/>
                                                    <Rectangle Fill="#131313"/>
                                                    <Rectangle Fill="#C000C0"/>
                                                    <Rectangle Fill="#131313"/>
                                                    <Rectangle Fill="#00C0C0"/>
                                                    <Rectangle Fill="#131313"/>
                                                    <Rectangle Fill="#C0C0C0"/>
                                                </UniformGrid>

                                                <!-- Bottom 25%: I, White, Q, Black pluge -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Fill="#00214C"/>
                                                    <Rectangle Grid.Column="1" Fill="#FFFFFF"/>
                                                    <Rectangle Grid.Column="2" Fill="#32006A"/>
                                                    <Rectangle Grid.Column="3" Fill="#131313"/>
                                                </Grid>

                                                <!-- Centered OSD Badge -->
                                                <Border Background="#D9000000" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ChannelName}" FontSize="11" FontWeight="Bold" Foreground="White" Margin="0,0,6,0"/>
                                                        <TextBlock Text="· OFF-AIR" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Live Video Frame Image -->
                                            <Image Source="{Binding FrameSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <!-- Column 1: Portrait Vertical Stereo Audio Level VU Meter -->
                                    <Border Grid.Column="1" Width="20" Margin="6,0,0,0" Background="#04070B" CornerRadius="4" BorderBrush="#162232" BorderThickness="1" Padding="2,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- dB Text Badge at Top -->
                                            <TextBlock Grid.Row="0" Text="{Binding AudioLevelText}" FontSize="7" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,2"/>

                                            <!-- Dual Vertical VU Meter Bars (L / R) -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Channel Bar (Vertical) -->
                                                <Border Grid.Column="0" Background="#060A10" CornerRadius="1" Margin="0,0,1,0" ClipToBounds="True">
                                                    <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding VuLevelLeft}" BorderThickness="0" Background="Transparent">
                                                        <ProgressBar.Foreground>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#10B981" Offset="0.0"/>
                                                                <GradientStop Color="#10B981" Offset="0.70"/>
                                                                <GradientStop Color="#F59E0B" Offset="0.85"/>
                                                                <GradientStop Color="#EF4444" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </ProgressBar.Foreground>
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Grid x:Name="TemplateRoot">
                                                                    <Border Background="{TemplateBinding Background}"/>
                                                                    <Border x:Name="PART_Track" />
                                                                    <Border x:Name="PART_Indicator" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" CornerRadius="1"/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                </Border>

                                                <!-- Right Channel Bar (Vertical) -->
                                                <Border Grid.Column="1" Background="#060A10" CornerRadius="1" Margin="1,0,0,0" ClipToBounds="True">
                                                    <ProgressBar Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding VuLevelRight}" BorderThickness="0" Background="Transparent">
                                                        <ProgressBar.Foreground>
                                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                <GradientStop Color="#10B981" Offset="0.0"/>
                                                                <GradientStop Color="#10B981" Offset="0.70"/>
                                                                <GradientStop Color="#F59E0B" Offset="0.85"/>
                                                                <GradientStop Color="#EF4444" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </ProgressBar.Foreground>
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Grid x:Name="TemplateRoot">
                                                                    <Border Background="{TemplateBinding Background}"/>
                                                                    <Border x:Name="PART_Track" />
                                                                    <Border x:Name="PART_Indicator" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" CornerRadius="1"/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                </Border>
                                            </Grid>

                                            <!-- L / R Labels at Bottom -->
                                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L" FontSize="7" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="R" FontSize="7" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Tile Footer: Resolution, FPS & Bitrate Telemetry -->
                                <DockPanel Grid.Row="2" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ResolutionFps}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BitrateKbps, StringFormat='{}{0:F0} kbps'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ============================================================= -->
        <!-- CUSTOM MULTIVIEW CONFIGURATION MODAL OVERLAY                  -->
        <!-- ============================================================= -->
        <Grid Grid.RowSpan="2" Background="#B304070B" Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomConfigOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{StaticResource GlassCardElevated}" Width="560" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Title -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="CUSTOM MULTIVIEW CONFIGURATION" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <Button Style="{StaticResource WindowCloseBtn}" Command="{Binding CloseCustomConfigCommand}" HorizontalAlignment="Right" Width="26" Height="26">
                            <Path Data="{StaticResource GeoClose}" Fill="White" Width="9" Height="9" Stretch="Uniform"/>
                        </Button>
                    </DockPanel>

                    <!-- Grid Dimensions Controls -->
                    <Border Grid.Row="1" Background="#0C1420" CornerRadius="6" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="GRID LAYOUT MATRIX" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Rows Selection -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="ROWS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CustomRows}" SelectedValuePath="Tag" Height="28">
                                        <ComboBoxItem Content="1 Row" Tag="1"/>
                                        <ComboBoxItem Content="2 Rows" Tag="2"/>
                                        <ComboBoxItem Content="3 Rows" Tag="3"/>
                                        <ComboBoxItem Content="4 Rows" Tag="4"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Columns Selection -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="COLUMNS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedValue="{Binding CustomColumns}" SelectedValuePath="Tag" Height="28">
                                        <ComboBoxItem Content="1 Column" Tag="1"/>
                                        <ComboBoxItem Content="2 Columns" Tag="2"/>
                                        <ComboBoxItem Content="3 Columns" Tag="3"/>
                                        <ComboBoxItem Content="4 Columns" Tag="4"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Total Tiles Summary -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL DISPLAY TILES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#162232" CornerRadius="4" Padding="8,5" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding TotalCustomTilesText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Tile Mappings -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="280" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="TILE FEED ASSIGNMENTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding CustomTileMappings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#080E17" CornerRadius="4" BorderBrush="#162232" BorderThickness="1" Padding="10,6" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock Text="{Binding TileLabel}" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Width="70" VerticalAlignment="Center"/>
                                                <ComboBox ItemsSource="{Binding AvailableChannels}" 
                                                          SelectedItem="{Binding SelectedChannel}" 
                                                          DisplayMemberPath="DisplayName" 
                                                          Height="26" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Action Buttons -->
                    <DockPanel Grid.Row="3">
                        <Button Style="{StaticResource GlassBtnSecondary}" Content="Reset to Default" Command="{Binding ResetToAutoCommand}" Width="120" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Style="{StaticResource GlassBtnSecondary}" Content="Cancel" Command="{Binding CloseCustomConfigCommand}" Width="90" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GlassBtnPrimary}" Content="Apply Layout" Command="{Binding ApplyCustomConfigCommand}" Width="120"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
