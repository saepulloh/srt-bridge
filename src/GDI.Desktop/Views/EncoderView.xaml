<UserControl x:Class="GDI.Desktop.Views.EncoderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GDI.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,20">

            <!-- PAGE HEADER -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SRT ENCODER CHANNELS" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Broadcast video ingest, GPU hardware encoding, and low-latency SRT transmission." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassBtnPrimary}" Content="+ Add Encoder" Command="{Binding AddEncoderCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource GlassBtnSecondary}" Content="Refresh" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- ENCODERS LIST -->
            <ItemsControl ItemsSource="{Binding Encoders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: VIDEO PREVIEW BOX (Live Image & SMPTE 75% Color Bars) -->
                                <Border Grid.Column="0" Background="#06090E" CornerRadius="6" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Height="158" Margin="0,0,16,0" ClipToBounds="True">
                                    <Grid>
                                        <!-- SMPTE 75% Broadcast Color Bars (shown when not live or no frame) -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="67*"/>
                                                <RowDefinition Height="8*"/>
                                                <RowDefinition Height="25*"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top 67%: 7 Color Bars -->
                                            <UniformGrid Grid.Row="0" Rows="1" Columns="7">
                                                <Rectangle Fill="#C0C0C0"/>
                                                <Rectangle Fill="#C0C000"/>
                                                <Rectangle Fill="#00C0C0"/>
                                                <Rectangle Fill="#00C000"/>
                                                <Rectangle Fill="#C000C0"/>
                                                <Rectangle Fill="#C00000"/>
                                                <Rectangle Fill="#0000C0"/>
                                            </UniformGrid>
                                            <!-- Middle 8% sub-bars -->
                                            <UniformGrid Grid.Row="1" Rows="1" Columns="7">
                                                <Rectangle Fill="#0000C0"/>
                                                <Rectangle Fill="#131313"/>
                                                <Rectangle Fill="#C000C0"/>
                                                <Rectangle Fill="#131313"/>
                                                <Rectangle Fill="#00C0C0"/>
                                                <Rectangle Fill="#131313"/>
                                                <Rectangle Fill="#C0C0C0"/>
                                            </UniformGrid>
                                            <!-- Bottom 25% pluge -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Fill="#00214C"/>
                                                <Rectangle Grid.Column="1" Fill="#FFFFFF"/>
                                                <Rectangle Grid.Column="2" Fill="#32006A"/>
                                                <Rectangle Grid.Column="3" Fill="#131313"/>
                                            </Grid>
                                            <!-- Center OSD overlay -->
                                            <Border Background="#D9000000" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Format}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding InputDevice}" FontSize="9" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Live Video Frame Image -->
                                        <Image Source="{Binding FrameSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- Header pill -->
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#26384F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource LiveGreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateBadge}" Value="ERROR">
                                                            <Setter Property="Background" Value="{StaticResource ProgramRedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateBadge}" FontSize="9" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="LightGray"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateBadge}" Value="ERROR">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Footer Audio VU Meter -->
                                        <ProgressBar Height="4" Value="{Binding VuLevel}" Minimum="0" Maximum="100" VerticalAlignment="Bottom" Background="#0B121C" Foreground="{StaticResource LiveGreenBrush}" BorderThickness="0" Margin="4"/>
                                    </Grid>
                                </Border>

                                <!-- RIGHT: ENCODER CONFIG & TELEMETRY -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                            <Border CornerRadius="3" Padding="6,2" Margin="10,0,0,0" Background="#1A3B5C" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1">
                                                <TextBlock Text="SRT CALLER/LISTENER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SrtTarget, StringFormat='{}Target: {0}'}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <!-- Specs Grid -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="INGEST DEVICE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding InputDevice}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ENCODER ENGINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CodecEncoder}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="BITRATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding BitrateKbps, StringFormat='{}{0} kbps'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LiveGreenBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="FPS / DROPS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CurrentFps, StringFormat='{}{0:F1} fps'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                <TextBlock Text="{Binding DroppedFrames, StringFormat='{} (drop {0})'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="AUDIO CODEC" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="AAC / 128 kbps (48kHz)" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Buttons (Live Transmit State Styling) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{StaticResource ChannelLiveStartBtn}" Width="125" Margin="0,0,8,0" Command="{Binding StartCommand}"/>
                                        <Button Style="{StaticResource ChannelLiveStopBtn}" Width="115" Margin="0,0,8,0" Command="{Binding StopCommand}"/>
                                        <Button Style="{StaticResource GlassBtnSecondary}" Content="Restart" Width="90" Margin="0,0,8,0" Command="{Binding RestartCommand}"/>
                                        <Button Style="{StaticResource GlassBtnSecondary}" Content="Configure..." Width="100" Command="{Binding ConfigCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
