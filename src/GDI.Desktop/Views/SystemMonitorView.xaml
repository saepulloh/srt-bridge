<UserControl x:Class="GDI.Desktop.Views.SystemMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GDI.Desktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,20">

            <!-- PAGE HEADER -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SYSTEM PERFORMANCE &amp; ENCODER MONITOR" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Hardware utilization, GPU video engines, thermal capacity, and active stream sessions." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- 4 METRIC GLASS CARDS -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU CARD -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding CpuLoad, StringFormat='{}{0:F1} %'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,2"/>
                        <ProgressBar Height="6" Value="{Binding CpuLoad}" Minimum="0" Maximum="100" Background="#111B29" Foreground="{StaticResource AccentBlueBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CpuName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- RAM CARD -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY (RAM)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding RamLoad, StringFormat='{}{0:F1} %'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,2"/>
                        <ProgressBar Height="6" Value="{Binding RamLoad}" Minimum="0" Maximum="100" Background="#111B29" Foreground="{StaticResource AccentCyanBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding RamText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- GPU VRAM CARD -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="GPU &amp; VRAM" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding VramText}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,6,0,6"/>
                        <TextBlock Text="{Binding GpuModel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding GpuTempText, StringFormat='{}Temperature: {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ENCODER SESSIONS CARD -->
                <Border Grid.Column="3" Style="{StaticResource GlassCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE SESSIONS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <DockPanel Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding EncoderSessions}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource LiveGreenBrush}"/>
                                <TextBlock Text="Encoders" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DecoderSessions}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningAmberBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="Decoders" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding NvencStatus}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ARCHITECTURAL HEALTH NOTE -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16" Padding="14">
                <StackPanel>
                    <TextBlock Text="BROADCAST PIPELINE ISOLATION" FontWeight="Bold" FontSize="12" Foreground="White" Margin="0,0,0,6"/>
                    <TextBlock Text="Each SRT channel runs in an isolated asynchronous process space with independent memory buffer pools and watchdog monitoring. A failure or network timeout on one channel never affects other live channels." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
